{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "env2",
      "type": "shell",
      "osx": {
        "command": "hostname > /tmp/sysinfo.txt"
      },
      "linux": {
        "command": "hostname > /tmp/sysinfo.txt"
      },
      "windows": {
        "command": "hostname > %TEMP%\\sysinfo.txt"
      },
      "runOptions": {
